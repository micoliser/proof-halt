# Frontend (Next.js) — copy to .env.local and fill in.
# Never put SYNC_SHARED_SECRET in NEXT_PUBLIC_* — the /api/sync proxy
# attaches it server-side.

# Backend indexer (Django). Paths are under /api.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Studionet contracts (fill after deploy — see ../deploy/notes.md)
# Names MUST start with NEXT_PUBLIC_ or the browser never sees them.
NEXT_PUBLIC_HALT_MODULE_ADDRESS=
NEXT_PUBLIC_DEMO_VAULT_ADDRESS=

# Studionet only
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999

# Server-only (Vercel / Node env). Used by app/api/sync/* to proxy POSTs.
# REQUIRED in production (NODE_ENV=production refuses to proxy without it).
# Must match backend SYNC_SHARED_SECRET. Never put this in NEXT_PUBLIC_*.
# API_URL defaults to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://localhost:8000
SYNC_SHARED_SECRET=
